# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
JWT_SECRET=replace-with-a-cryptographically-secure-32-byte-secret-key
CORS_ORIGIN=http://localhost:5173

# Seed Credentials (used by `npm run seed`; generated randomly if omitted)
SEED_ADMIN_EMAIL=alex@logflow.dev
SEED_ADMIN_PASSWORD=

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.t0cnjw8.mongodb.net/logflow?retryWrites=true&w=majority
MONGODB_DB=logflow

# Log Storage Adapter ("mongodb" | "postgres" | "clickhouse")
LOG_STORE_DRIVER=mongodb

# PostgreSQL (Metadata + fallback Log Store)
DATABASE_URL=postgresql://logflow:logflow@localhost:5432/logflow

# ClickHouse Configuration (when LOG_STORE_DRIVER=clickhouse)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=logflow
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Ingestion Rate Limit (events per minute per API key)
INGEST_RATE_LIMIT_PER_MIN=5000
INGEST_BATCH_FLUSH_MS=250

# Alert Notifications
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=alerts@logflow.local

# Frontend (Vite)
VITE_API_URL=http://localhost:4000
