{
  "name": "logflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm --workspace @logflow/api run dev",
    "dev:web": "npm --workspace @logflow/web run dev",
    "seed": "npm --workspace @logflow/api run seed"
  }
}

